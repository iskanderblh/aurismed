# =============================================================================
# AurisMED — variables d'environnement
# Copiez ce fichier en .env.local et renseignez les valeurs. Ne commitez jamais .env.local.
# =============================================================================

# --- Application -------------------------------------------------------------
# URL publique de l'application (utilisée dans les liens envoyés par e-mail).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (requis dès la phase 1) ----------------------------------------
# Tableau de bord Supabase > Project Settings > API.
# La clé "publishable" (ou l'ancienne clé "anon") est publique par conception :
# la sécurité repose sur la Row Level Security définie dans supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- OpenAI (requis à partir des phases 3 et 4) ------------------------------
# Lue uniquement côté serveur. Ne jamais la préfixer par NEXT_PUBLIC_.
OPENAI_API_KEY=
# Modèles configurables (vérifiez les modèles disponibles sur votre compte).
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_EXTRACTION_MODEL=gpt-4.1
