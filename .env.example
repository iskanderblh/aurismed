# =============================================================================
# AurisMED (version locale) — variables d'environnement, toutes facultatives.
# Copiez ce fichier en .env.local pour modifier une valeur. Ne commitez jamais .env.local.
# Aucune clé d'API : la transcription et l'analyse tournent sur ce poste.
# =============================================================================

# --- Données locales -----------------------------------------------------------
# Dossier de la base SQLite, des fichiers chiffrés et de la clé (./data par défaut).
# AURISMED_DATA_DIR=D:\AurisMED\data
# Clé de chiffrement des fichiers (32 octets en base64). Par défaut, elle est créée
# au premier lancement dans <données>\cle\aurismed.key : sauvegardez-la à part.
# AURISMED_ENCRYPTION_KEY=
# Durée d'inactivité avant déconnexion, en heures (12 par défaut).
# AURISMED_SESSION_HOURS=12

# --- Moteur IA local -----------------------------------------------------------
# Dossier des moteurs installés par windows\Installer-AurisMED.cmd (./moteurs par défaut).
# AURISMED_ENGINES_DIR=
# Démarrage automatique de whisper.cpp et d'Ollama avec AurisMED (1 par défaut).
# AURISMED_AUTOSTART_ENGINES=1
# Adresses des moteurs : uniquement 127.0.0.1 ou localhost (toute autre adresse est refusée).
# WHISPER_URL=http://127.0.0.1:8178
# OLLAMA_URL=http://127.0.0.1:11434
# Modèles par défaut (le choix fait dans Paramètres > Moteur IA local est prioritaire).
# WHISPER_MODEL=ggml-large-v3-turbo-q5_0.bin
# OLLAMA_MODEL=qwen2.5:7b-instruct
# Nombre de cœurs utilisés par la transcription (4 par défaut).
# WHISPER_THREADS=4
# Emplacements des programmes, si non standard.
# WHISPER_SERVER_BIN=
# OLLAMA_BIN=

# --- Enregistrement et affichage ----------------------------------------------
# Durée d'un segment d'enregistrement micro, en secondes (600 par défaut).
# NEXT_PUBLIC_RECORDING_SEGMENT_SECONDS=600
# Fuseau d'affichage des dates et heures (identique serveur / navigateur).
# NEXT_PUBLIC_APP_TIME_ZONE=Europe/Paris
